"use client";
import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { CANTONS } from "../../lib/cantons";
import CantonFlag from "../../components/CantonFlag";
import { supabase } from "../../lib/supabaseClient";

export default function CantonsPage() {
  const router = useRouter();
  const [counts, setCounts] = useState({});

  useEffect(() => {
    supabase.from("jobs").select("canton").eq("status", "published").then(({ data }) => {
      const c = {};
      (data || []).forEach((j) => { c[j.canton] = (c[j.canton] || 0) + 1; });
      setCounts(c);
    });
  }, []);

  return (
    <div className="container" style={{ padding: "40px 32px 80px" }}>
      <h1 style={{ fontSize: 26, marginBottom: 6 }}>Apotheken nach Kanton</h1>
      <p style={{ fontSize: 14, color: "var(--text2)", marginBottom: 28, maxWidth: 520 }}>
        Wähle einen Kanton, um offene Stellen dort direkt zu sehen.
      </p>
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(150px, 1fr))", gap: 12 }}>
        {CANTONS.map((c) => (
          <button
            key={c.code}
            onClick={() => router.push(`/?canton=${c.code}`)}
            className="panel"
            style={{ display: "flex", alignItems: "center", gap: 10, textAlign: "left", cursor: "pointer", border: "1px solid var(--line)" }}
          >
            <CantonFlag code={c.code} size={30} />
            <div>
              <div style={{ fontSize: 13.5, fontWeight: 600, color: "var(--pine)" }}>{c.name}</div>
              <div style={{ fontSize: 12, color: "var(--text2)" }}>{counts[c.code] || 0} {counts[c.code] === 1 ? "Stelle" : "Stellen"}</div>
            </div>
          </button>
        ))}
      </div>
    </div>
  );
}
